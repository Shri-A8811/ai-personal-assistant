<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_dark"
    app:strokeColor="@color/card_stroke_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Collapsed Row (Hermes Agent Style) -->
        <LinearLayout
            android:id="@+id/layoutRowHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status Dot (Green if key configured, gray if not) -->
            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_model_pill" />

            <TextView
                android:id="@+id/txtProviderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="OpenRouter"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtKeyPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="Paste OpenRouter key"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/imgChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Expanded Configuration Panel -->
        <LinearLayout
            android:id="@+id/layoutExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <!-- Custom URL Input (Only for custom provider) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCustomBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:boxStrokeColor="@color/accent_gemini_blue"
                app:hintTextColor="@color/accent_gemini_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCustomBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Base URL (e.g. http://10.0.2.2:11434/v1/)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- API Key Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/accent_gemini_blue"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/accent_gemini_blue">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editProviderKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API Key"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Actions Row: Save & Fetch + Search & Pin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressProviderFetch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/accent_gemini_blue"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchModelsForProvider"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🔍 Search Models"
                    android:textColor="@color/accent_gemini_blue"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveProviderKey"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/accent_gemini_blue"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Save &amp; Fetch"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
