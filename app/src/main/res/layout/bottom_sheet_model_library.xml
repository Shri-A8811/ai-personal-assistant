<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_model_pill" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model Library &amp; Search"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLibModelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search models across all providers"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibRefresh"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/surface_elevated_dark"
            android:text="Refresh"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:strokeColor="@color/card_stroke_dark"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted" />

        <EditText
            android:id="@+id/editLibSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search by name, ID, or keywords (e.g. llama, free)..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnLibClearSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Horizontal Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Models"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFreeOnly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Free Tier Only"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPinnedOnly"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Pinned Only"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOpenRouter"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenRouter"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGroq"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groq"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGemini"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeepSeek"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DeepSeek"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipXai"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="xAI"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnthropic"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anthropic"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOpenAi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenAI"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFireworks"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fireworks"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressLibLoading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/accent_gemini_blue"
        android:visibility="gone" />

    <!-- Models RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLibModels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutLibEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/app_logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/txtLibEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No models found"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLibEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="No models matched your search or no providers configured. Add an API key in Settings to fetch live models."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLibGoToSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/surface_elevated_dark"
            android:text="⚙️ Open Provider Settings"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/card_stroke_dark"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Quick Add Model by Exact ID Bar -->
    <LinearLayout
        android:id="@+id/layoutQuickAddModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editQuickModelId"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_box"
            android:hint="Type model ID (e.g. meta-llama/llama-3.3-70b-instruct:free)..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickPinModel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/accent_gemini_blue"
            android:text="+ Pin"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="11sp"
            app:cornerRadius="19dp" />
    </LinearLayout>

    <!-- Bottom Done Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLibDone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/accent_gemini_blue"
        android:text="Done"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="22dp" />

</LinearLayout>
