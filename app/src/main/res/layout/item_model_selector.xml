<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardModelSelector"
    style="@style/ModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/card_stroke_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Provider Icon/Badge Container -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_model_pill">

            <TextView
                android:id="@+id/txtProviderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✨"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Center Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtModelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Model Name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtProviderBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_model_pill"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="GEMINI"
                    android:textColor="@color/accent_gemini_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <!-- Free Badge -->
                <TextView
                    android:id="@+id/badgeFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_free"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="FREE"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtModelSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="gemini-2.0-flash"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Active Checkmark Indicator -->
        <ImageView
            android:id="@+id/imgSelectedCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/accent_gemini_blue" />

        <!-- One-Tap Remove / Unpin Button -->
        <ImageView
            android:id="@+id/btnRemoveModel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove model from favorites"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
